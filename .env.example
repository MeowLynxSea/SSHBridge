# Server configuration
WEB_PORT=3000
SSH_PORT=2222

# Tunnel configuration
BASE_TUNNEL_HOST=your-server-domain.com

# Security
JWT_SECRET=your-jwt-secret-key-here

# Optional: Database path (defaults to ./database.sqlite)
# DATABASE_PATH=./database.sqlite

# Optional: Host key path (defaults to ./host.key)
# HOST_KEY_PATH=./host.key

# Optional: Footer text (defaults to "Created by MeowLynxSea © 2025 | Secure SSH Tunnel Management")
# Example with ICP filing:
# NEXT_PUBLIC_FOOTER_TEXT=MeowLynxSea © 2025 | Secure SSH Tunnel Management | 京ICP备2025000001号
# NEXT_PUBLIC_FOOTER_TEXT=Your Company Name © 2025 | 京公网安备11010802020234号